---
import { SEO } from "astro-seo";
import "../index.css";
import CookieConsent from "../components/CookieConsent.astro";

interface AlternateLink {
  href: string;
  hreflang: string;
}

interface Props {
  title: string;
  description?: string;
  robots?: string;
  author?: string;
  keywords?: string;
  canonicalUrl: string;
  preloadImage?: string;
  imageUrl?: string;
  imageType?: string;
  imageWidth?: number;
  imageHeight?: number;
  siteName?: string;
  locale?: string;
  alternates?: AlternateLink[];
  twitterCard?: string;
  twitterImageAlt?: string;
  lang?: string;
  bodyClass?: string;
  jsonLd?: unknown;
  titleId?: string;
  descriptionId?: string;
}

const {
  title,
  description = "",
  robots = "index,follow,max-image-preview:large",
  author,
  keywords,
  canonicalUrl,
  preloadImage,
  imageUrl,
  imageType = "image/png",
  imageWidth = 1200,
  imageHeight = 630,
  siteName = title,
  locale = "en_US",
  alternates = [],
  twitterCard = "summary_large_image",
  twitterImageAlt,
  lang = "en",
  bodyClass,
  jsonLd,
  titleId,
  descriptionId,
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Critical first-paint styles: avoid white flash before main CSS arrives -->
    <style is:inline>
      html {
        background-color: #f6f4f0;
        color-scheme: light;
      }
      html.dark {
        background-color: #0b0d12;
        color-scheme: dark;
      }
      html,
      body {
        margin: 0;
        min-height: 100%;
        background-color: inherit;
      }
      html[data-redirecting] body {
        visibility: hidden;
      }
      #cookie-settings-button:not(.is-ready) {
        display: none !important;
      }
    </style>
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const isDark = storedTheme === "dark" || (!storedTheme && prefersDark);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
    <script is:inline define:vars={{ lang }}>
      // Retrieve stored language or fallback to browser language
      const stored = localStorage.getItem("language");
      const userLang = stored || navigator.language.split("-")[0];
      const preferred = (userLang === "pt" || userLang === "en") ? userLang : "en";

      // Redirect if preferred language doesn't match the current page language
      if (preferred !== lang) {
        document.documentElement.setAttribute("data-redirecting", "");
        const newPath = preferred === "pt" ? "/portfolio/pt/" : "/portfolio/";
        window.location.replace(newPath);
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
    <link rel="icon" type="image/png" href="/portfolio/favicon.svg" />
    <!-- Fallback for some browsers -->

    <SEO
      title={title}
      description={description}
      canonical={canonicalUrl}
      noindex={robots?.includes("noindex")}
      nofollow={robots?.includes("nofollow")}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: imageUrl || "",
          url: canonicalUrl,
        },
        optional: {
          description: description,
          siteName: siteName,
          locale: locale,
        },
        image: imageUrl
          ? {
              url: imageUrl,
              alt: twitterImageAlt,
              width: imageWidth,
              height: imageHeight,
              type: imageType,
            }
          : undefined,
      }}
      twitter={{
        card: twitterCard as any,
        site: "@nunofbcastro", // Optional: Add if known or pass via props
        creator: author,
        title: title,
        description: description,
        image: imageUrl,
        imageAlt: twitterImageAlt,
      }}
      extend={{
        meta: [
          { name: "theme-color", content: "#0f172a" },
          { name: "author", content: author },
          { name: "keywords", content: keywords },
          // Force the full robots string to ensure max-image-preview is preserved if not handled by standard boolean props
          // Note: SEO component might generate its own robots tag. If strictly needed, we can rely on standard index/follow
          // or check if we should suppress the default one if possible.
          // For now, let's trust astro-seo handling of noindex/nofollow and if the user needs advanced robots, they might need to use extend exclusively.
          // However, to keep it simple and safe:
          ...(robots &&
          !robots.includes("noindex") &&
          !robots.includes("nofollow") &&
          robots !== "index,follow"
            ? [{ name: "robots", content: robots }]
            : []),
        ].filter((meta) => meta.content),
        link: [
          ...(preloadImage
            ? [{ rel: "preload", as: "image", href: preloadImage }]
            : []),
          ...alternates.map(({ href, hreflang }) => ({
            rel: "alternate",
            href,
            hreflang,
          })),
        ],
      }}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700;800&family=Syne:wght@400;500;600;700;800&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700;800&family=Syne:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700;800&family=Syne:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }

    <!-- Global site tag (gtag.js) - Consent Mode Setup -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;
      
      // Default all consent parameters to denied
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });
    </script>
    <script>
      import { initSessionTracking } from "../lib/tracking";
      initSessionTracking();
    </script>

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <CookieConsent />
  </body>
</html>

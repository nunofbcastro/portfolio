---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteUrl = Astro.site ?? new URL("https://nunofbcastro.github.io");
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<BaseLayout
  title="404 | Nuno Castro Portfolio"
  titleId="page-title"
  description="The page you are looking for does not exist."
  descriptionId="page-description"
  robots="noindex,follow"
  canonicalUrl={pageUrl}
  bodyClass="min-h-screen bg-background text-foreground"
>
  <script slot="head" is:inline>
      const i18n = {
        en: {
          pageTitle: "404 | Nuno Castro Portfolio",
          pageDescription: "The page you are looking for does not exist.",
          heading: "Page Not Found",
          message:
            "The page may have been moved, renamed, or does not exist. Use one of the links below to continue browsing.",
          goHome: "Go to Homepage",
          contact: "Contact Me"
        },
        pt: {
          pageTitle: "404 | Portfolio de Nuno Castro",
          pageDescription: "A pagina que procuras nao existe.",
          heading: "Pagina nao encontrada",
          message:
            "A pagina pode ter sido movida, renomeada ou nao existe. Usa uma das opcoes abaixo para continuar.",
          goHome: "Ir para a pagina inicial",
          contact: "Contactar"
        }
      };

      const storedLanguage = localStorage.getItem("language");
      const detectedLang =
        storedLanguage === "pt" || storedLanguage === "en"
          ? storedLanguage
          : navigator.language?.toLowerCase().startsWith("pt")
            ? "pt"
            : "en";
      const t = i18n[detectedLang];
      document.documentElement.lang = detectedLang === "pt" ? "pt-PT" : "en";
      document.title = t.pageTitle;

      const metaDescription = document.getElementById("page-description");
      if (metaDescription) {
        metaDescription.setAttribute("content", t.pageDescription);
      }

      const heading = document.querySelector("[data-i18n='heading']");
      const message = document.querySelector("[data-i18n='message']");
      const goHome = document.querySelector("[data-i18n='goHome']");
      const contact = document.querySelector("[data-i18n='contact']");
      if (heading) heading.textContent = t.heading;
      if (message) message.textContent = t.message;
      if (goHome) goHome.textContent = t.goHome;
      if (contact) contact.textContent = t.contact;
  </script>
  <main class="relative min-h-screen overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,hsl(var(--primary)/0.2),transparent_35%),radial-gradient(circle_at_85%_80%,hsl(var(--accent)/0.15),transparent_35%)]"></div>

    <section class="container relative z-10 mx-auto flex min-h-screen items-center justify-center px-4 py-16">
      <div class="w-full max-w-2xl rounded-2xl border border-border/60 bg-card/70 p-8 text-center shadow-xl backdrop-blur-md md:p-12">
        <p class="mb-3 text-sm font-semibold tracking-[0.2em] text-primary">ERROR 404</p>
        <h1 data-i18n="heading" class="mb-4 text-4xl font-extrabold leading-tight md:text-6xl">
          Page Not Found
        </h1>
        <p data-i18n="message" class="mx-auto mb-8 max-w-xl text-base text-muted-foreground md:text-lg">
          The page may have been moved, renamed, or does not exist. Use one of the links below to continue browsing.
        </p>

        <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/portfolio/"
            data-i18n="goHome"
            class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
          >
            Go to Homepage
          </a>
          <a
            href="mailto:nunofbcastro@gmail.com"
            data-i18n="contact"
            class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-background px-6 text-sm font-semibold transition-colors hover:bg-muted"
          >
            Contact Me
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

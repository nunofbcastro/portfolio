---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Header } from "../components/Header";
import { HeroSection } from "../components/HeroSection";
import { AboutSection } from "../components/AboutSection";
import { JourneySection } from "../components/JourneySection";
import { ProjectsSection } from "../components/ProjectsSection";
import { AwardsSection } from "../components/AwardsSection";
import { TestimonialsSection } from "../components/TestimonialsSection";
import { ContactSection } from "../components/ContactSection";
import { Footer } from "../components/Footer";
import { SectionDivider } from "../components/SectionDivider";
import { portfolioData } from "../data/portfolio";
import heroImage from "../assets/hero-image.jpg";

const currentLocale = (Astro.currentLocale || "en") as "en" | "pt";

const siteUrl = Astro.site ?? new URL("https://nunofbcastro.github.io");
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

// Optimize hero image for LCP
const optimizedHero = await getImage({ src: heroImage, format: 'webp', width: 1920 });
const imageUrl = new URL("/portfolio/og-image.png", siteUrl).toString();

const person = portfolioData.personal;
const currentYear = new Date().getFullYear();

const description = `${person.name} - ${person.title[currentLocale]}. ${person.subtitle[currentLocale]}.`;
const keywords = "Nuno Castro, Software Engineer, Portfolio, React, React Native, TypeScript, .NET, Web Development, Mobile Development, Porto, ESTG, ISEP, Instituto Politécnico do Porto, B2F - BUSINESSTOFUTURE";
const title = `${person.name} | Portfolio`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: person.name,
      url: pageUrl,
      image: imageUrl,
      jobTitle: person.title[currentLocale],
      email: person.email,
      address: {
        "@type": "PostalAddress",
        addressLocality: person.location[currentLocale],
        addressCountry: "PT"
      },
      sameAs: [
        "https://github.com/nunofbcastro",
        "https://www.linkedin.com/in/nunofbcastro/"
      ]
    },
    {
      "@type": "WebSite",
      name: title,
      url: pageUrl,
      inLanguage: ["en", "pt-PT"]
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  author={person.name}
  keywords={keywords}
  canonicalUrl={pageUrl}
  preloadImage={optimizedHero.src}
  imageUrl={imageUrl}
  locale={currentLocale === "pt" ? "pt_PT" : "en_US"}
  alternateLocale={currentLocale === "pt" ? "en_US" : "pt_PT"}
  twitterImageAlt="Nuno Castro portfolio social preview"
  jsonLd={jsonLd}
  lang={currentLocale}
>
  <link slot="head" rel="alternate" hrefLang="en" href={new URL("/portfolio/", siteUrl).toString()} />
  <link slot="head" rel="alternate" hrefLang="pt-PT" href={new URL("/portfolio/pt/", siteUrl).toString()} />
  <link slot="head" rel="alternate" hrefLang="x-default" href={new URL("/portfolio/", siteUrl).toString()} />
  
  <Header language={currentLocale} client:load />

  <main id="main-content">
    {portfolioData.sections.hero && (
      <HeroSection language={currentLocale} heroImageUrl={optimizedHero.src} client:load />
    )}

    {portfolioData.sections.about && (
      <>
        <AboutSection language={currentLocale} client:visible />
        <SectionDivider />
      </>
    )}

    {portfolioData.sections.timeline && (
      <>
        <JourneySection language={currentLocale} client:visible />
        <SectionDivider />
      </>
    )}

    {portfolioData.sections.projects && (
      <ProjectsSection language={currentLocale} client:visible />
    )}

    {portfolioData.sections.awards && (
      <AwardsSection language={currentLocale} client:visible />
    )}

    {portfolioData.sections.testimonials && (
      <TestimonialsSection language={currentLocale} />
    )}

    {portfolioData.sections.contact && (
      <ContactSection language={currentLocale} client:visible />
    )}
  </main>

  <Footer language={currentLocale} currentYear={currentYear} />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import App from "../react/App";
import { portfolioData } from "../data/portfolio";
import heroImage from "../assets/hero-image.jpg";

const siteUrl = Astro.site ?? new URL("https://nunofbcastro.github.io");
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL("/portfolio/og-image.png", siteUrl).toString();
const person = portfolioData.personal;
const currentYear = new Date().getFullYear();
const descriptionEn = `${person.name} - ${person.title.en}. ${person.subtitle.en}.`;
const title = `${person.name} | Portfolio`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: person.name,
      url: pageUrl,
      image: imageUrl,
      jobTitle: person.title.en,
      email: person.email,
      address: {
        "@type": "PostalAddress",
        addressLocality: person.location.en,
        addressCountry: "PT"
      },
      sameAs: [
        "https://github.com/nunofbcastro",
        "https://www.linkedin.com/in/nunofbcastro/"
      ]
    },
    {
      "@type": "WebSite",
      name: title,
      url: pageUrl,
      inLanguage: ["en", "pt-PT"]
    }
  ]
};
---

<BaseLayout
  title={title}
  description={descriptionEn}
  author={person.name}
  keywords="Nuno Castro, Software Engineer, Portfolio, React, Astro, TypeScript, .NET"
  canonicalUrl={pageUrl}
  preloadImage={heroImage.src}
  imageUrl={imageUrl}
  locale="en_US"
  alternateLocale="pt_PT"
  twitterImageAlt="Nuno Castro portfolio social preview"
  jsonLd={jsonLd}
>
  <link slot="head" rel="alternate" hrefLang="en" href={pageUrl} />
  <link slot="head" rel="alternate" hrefLang="pt-PT" href={pageUrl} />
  <link slot="head" rel="alternate" hrefLang="x-default" href={pageUrl} />
  <App client:load currentYear={currentYear} />
</BaseLayout>
